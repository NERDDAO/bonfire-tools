# Copy to .env, fill in, then load it before running the tools:
#   set -a; source .env; set +a
# Never commit .env.

# Bonfires API key (required by ingest.py and server.py)
DELVE_API_KEY=

# Bonfire to read from / write to (required by ingest.py and server.py)
BONFIRE_ID=

# Optional: API base URL for ingest.py (default https://tnt-v2.api.bonfires.ai)
# DELVE_BASE_URL=
